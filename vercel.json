{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build && mkdir -p estatico && printf 'User-agent: *\\nDisallow: /\\n' > estatico/robots.txt",
  "outputDirectory": "estatico",
  "regions": ["gru1"],
  "functions": {
    "api/index.js": {
      "includeFiles": "{dist/**,exemplos/**,src/fonts/*.woff2,src/marca/*.svg}",
      "maxDuration": 30
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
